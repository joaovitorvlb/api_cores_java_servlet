{
  // Desativa a importação automática de projetos
  "java.project.importOnFirstTimeStartup": "disabled",
  "java.project.importHint": false,
  
  // Impede que ele tente configurar o build
  "java.configuration.updateBuildConfiguration": "disabled",

  // Define a pasta src como caminho de origem
  "java.project.sourcePaths": ["src"],

  // Adiciona bibliotecas externas ao classpath
  "java.project.referencedLibraries": [
    "lib/jakarta.servlet-api-6.1.0.jar",
    "lib/json-20250107.jar",
    "lib/postgresql-42.2.23.jar"
  ],

  // Desativa suporte a Maven/Gradle
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,

  // Garante que ele não crie a pasta "bin"
  "java.build.outputPath": "doNotUse",

  // Silencia avisos sobre ausência de build system
  "java.errors.incompleteClasspath.severity": "ignore"
}